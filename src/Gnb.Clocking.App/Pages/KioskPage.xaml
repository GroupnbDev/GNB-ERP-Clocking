<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gnb.Clocking.App.ViewModels"
             xmlns:camera="clr-namespace:Gnb.Clocking.App.Camera"
             xmlns:controls="clr-namespace:Gnb.Clocking.App.Controls"
             x:Class="Gnb.Clocking.App.Pages.KioskPage"
             x:DataType="vm:KioskViewModel"
             x:Name="PageRoot"
             BackgroundColor="{DynamicResource Canvas}">

    <Grid>
        <!-- Ambient backdrop: static dot grid, GPU-moved glows, scan flashes. -->
        <controls:AuroraBackdrop x:Name="Aurora" />

        <Grid RowDefinitions="Auto,*,Auto" Padding="28,20,28,14" RowSpacing="18">

            <!-- ============ Header ============ -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24">
                <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                    <Border x:Name="LogoTile" WidthRequest="52" HeightRequest="52" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource Brand}" Offset="0" />
                                <GradientStop Color="{StaticResource Highlight}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#AB1100" Opacity="0.45" Radius="22" Offset="0,6" />
                        </Border.Shadow>
                        <Label Text="GN" FontFamily="OpenSansSemibold" FontSize="19" TextColor="#FFFFFF"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                        <Label Text="GroupNB" FontFamily="OpenSansSemibold" FontSize="24" />
                        <Label Text="RFID time clock" FontSize="14" TextColor="{DynamicResource Muted}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Padding="16,10"
                        BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 22">
                    <HorizontalStackLayout Spacing="12">
                        <Grid WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                            <Border x:Name="LiveRipple" WidthRequest="10" HeightRequest="10" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5" BackgroundColor="{StaticResource Highlight}"
                                    HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border x:Name="LiveDot" WidthRequest="10" HeightRequest="10" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5" BackgroundColor="{StaticResource Highlight}"
                                    HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="Reader live" FontFamily="OpenSansSemibold" FontSize="14" VerticalOptions="Center" />
                        <BoxView WidthRequest="1" HeightRequest="16" Color="{DynamicResource Line}" VerticalOptions="Center" />
                        <Border x:Name="ServerDot" WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                StrokeShape="RoundRectangle 4" BackgroundColor="#718096" VerticalOptions="Center" />
                        <Label Text="{Binding ServerCaption}" FontSize="14" TextColor="{DynamicResource Muted}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <HorizontalStackLayout Grid.Column="2" Spacing="24" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="0">
                            <Label x:Name="HoursLabel" Text="{Binding ClockHours}" FontFamily="OpenSansSemibold" FontSize="44" />
                            <Label x:Name="Colon" Text=":" FontFamily="OpenSansSemibold" FontSize="40" Margin="3,-3,3,0" />
                            <Label x:Name="MinutesLabel" Text="{Binding ClockMinutes}" FontFamily="OpenSansSemibold" FontSize="44" />
                            <Label Text="{Binding ClockMeridiem}" FontSize="16" TextColor="{DynamicResource Muted}"
                                   VerticalOptions="End" Margin="8,0,0,10" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding DateLine}" FontSize="14" TextColor="{DynamicResource Muted}"
                               HorizontalTextAlignment="End" Margin="0,-4,0,0" />
                    </VerticalStackLayout>

                    <!-- Segmented appearance switch with a sliding indicator. -->
                    <Border Padding="4" VerticalOptions="Center" StrokeThickness="1" StrokeShape="RoundRectangle 20"
                            BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}">
                        <Grid ColumnDefinitions="72,72,72" HeightRequest="34">
                            <Border x:Name="ThemeIndicator" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource Brand}" Offset="0" />
                                        <GradientStop Color="{StaticResource Highlight}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Label x:Name="ThemeLight" Grid.Column="0" Text="Light" FontFamily="OpenSansSemibold" FontSize="13"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeTapped" CommandParameter="Light" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="ThemeDark" Grid.Column="1" Text="Dark" FontFamily="OpenSansSemibold" FontSize="13"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeTapped" CommandParameter="Dark" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="ThemeSystem" Grid.Column="2" Text="System" FontFamily="OpenSansSemibold" FontSize="13"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeTapped" CommandParameter="System" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- ============ Body ============ -->
            <Grid Grid.Row="1" ColumnDefinitions="1.75*,1*" ColumnSpacing="20">

                <!-- Scanner stage -->
                <Border Grid.Column="0" BackgroundColor="{DynamicResource Stage}"
                        Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 28">
                    <Grid RowDefinitions="Auto,*,Auto" Padding="24,20,24,22">

                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Border x:Name="PhaseChip" Padding="12,6" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                    <HorizontalStackLayout Spacing="8">
                                        <Border x:Name="PhaseDot" WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4" VerticalOptions="Center" />
                                        <Label x:Name="PhaseLabel" Text="Ready" FontFamily="OpenSansSemibold" FontSize="13"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Label Text="Badge + photo verification" FontSize="13" TextColor="{DynamicResource Faint}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" Padding="12,6" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}">
                                <HorizontalStackLayout Spacing="8">
                                    <Border x:Name="CameraDot" WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 4" BackgroundColor="#718096" VerticalOptions="Center" />
                                    <Label x:Name="CameraChipLabel" Text="Starting camera" FontSize="13"
                                           TextColor="{DynamicResource Muted}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Hidden sink for the USB reader's keystrokes. -->
                            <Entry x:Name="RfidEntry"
                                   Grid.ColumnSpan="2"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Opacity="0"
                                   HeightRequest="1"
                                   WidthRequest="1"
                                   TextColor="Transparent"
                                   BackgroundColor="Transparent"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"
                                   ClearButtonVisibility="Never"
                                   Keyboard="Plain"
                                   ReturnType="Done"
                                   TextChanged="OnRfidTextChanged"
                                   Completed="OnRfidCompleted" />
                        </Grid>

                        <!-- Camera, halo and floating HUD. Sized in code from the available space. -->
                        <Grid x:Name="ScannerArea" Grid.Row="1" SizeChanged="OnScannerSizeChanged">
                            <controls:ScannerHalo x:Name="Halo" HorizontalOptions="Center" VerticalOptions="Center" />

                            <Border x:Name="CameraFrame" WidthRequest="300" HeightRequest="300" Padding="0"
                                    StrokeThickness="3" BackgroundColor="#000000"
                                    HorizontalOptions="Center" VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 150">
                                <Grid>
                                    <camera:ClockCameraView x:Name="ClockCamera" />
                                    <Label x:Name="CameraFallback" Text="Starting camera" TextColor="#FFFFFF"
                                           FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                           Margin="24,0" />
                                    <Image x:Name="SuccessPhotoImage" Source="{Binding SuccessPhoto}" Aspect="AspectFill"
                                           IsVisible="False" />
                                    <BoxView x:Name="ScanLine" HeightRequest="90" VerticalOptions="Center"
                                             Opacity="0" InputTransparent="True">
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00C70000" Offset="0" />
                                                <GradientStop Color="#40C70000" Offset="0.8" />
                                                <GradientStop Color="#FFC70000" Offset="0.97" />
                                                <GradientStop Color="#00C70000" Offset="1" />
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>
                                    <Border x:Name="Shutter" BackgroundColor="#FFFFFF" Opacity="0" InputTransparent="True"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 150" />
                                </Grid>
                            </Border>

                            <Border x:Name="SuccessBadge" IsVisible="False" WidthRequest="64" HeightRequest="64"
                                    StrokeThickness="4" Stroke="{DynamicResource Canvas}" StrokeShape="RoundRectangle 32"
                                    BackgroundColor="{StaticResource Success}"
                                    HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                                <Border.Shadow>
                                    <Shadow Brush="#28A745" Opacity="0.6" Radius="20" />
                                </Border.Shadow>
                                <Label Text="✓" FontFamily="OpenSansSemibold" FontSize="30" TextColor="#FFFFFF"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>

                            <!-- Identity HUD while the photo is taken. -->
                            <Border x:Name="IdentityChip" IsVisible="False" VerticalOptions="End" HorizontalOptions="Center"
                                    Padding="12,12,16,12" Margin="0,0,0,2" StrokeThickness="1" StrokeShape="RoundRectangle 24"
                                    BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}">
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Opacity="0.25" Radius="30" Offset="0,10" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="14">
                                    <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                            VerticalOptions="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{StaticResource Brand}" Offset="0" />
                                                <GradientStop Color="{StaticResource Highlight}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Label Text="{Binding Initials}" FontFamily="OpenSansSemibold" FontSize="19" TextColor="#FFFFFF"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1" MaximumWidthRequest="380">
                                        <Label Text="{Binding CandidateName}" FontFamily="OpenSansSemibold" FontSize="20"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding AssignmentLine}" FontSize="13" TextColor="{DynamicResource Muted}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding StatusDetail}" FontSize="13" TextColor="{DynamicResource Faint}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Border x:Name="ActionPill" Grid.Column="2" Padding="14,8" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                                        <Label x:Name="ActionPillLabel" Text="{Binding ActionTitle}" FontFamily="OpenSansSemibold"
                                               FontSize="14" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="UnknownBanner" IsVisible="False" VerticalOptions="Start" HorizontalOptions="Center"
                                    Padding="14,12,20,12" Margin="0,4,0,0" StrokeThickness="1" StrokeShape="RoundRectangle 18"
                                    BackgroundColor="{DynamicResource DangerSoft}" Stroke="{DynamicResource Danger}">
                                <HorizontalStackLayout Spacing="12">
                                    <Border WidthRequest="26" HeightRequest="26" StrokeThickness="0" StrokeShape="RoundRectangle 13"
                                            BackgroundColor="#FFFFFF" VerticalOptions="Center">
                                        <Label Text="!" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{DynamicResource Danger}"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label Text="{Binding UnknownMessage}" TextColor="#FFFFFF" FontSize="16"
                                           FontFamily="OpenSansSemibold" VerticalOptions="Center" MaximumWidthRequest="560"
                                           LineBreakMode="WordWrap" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Prompt / result copy and the progress stepper. Fixed height so the camera never jumps. -->
                        <Grid Grid.Row="2" RowDefinitions="*,Auto" HeightRequest="230" RowSpacing="12">
                            <VerticalStackLayout x:Name="PromptStack" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Prompt}" FontFamily="OpenSansSemibold" FontSize="30"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding PromptDetail}" FontSize="16" TextColor="{DynamicResource Muted}"
                                       HorizontalTextAlignment="Center" />
                                <HorizontalStackLayout IsVisible="{Binding ShowResetConfirm}" Spacing="12"
                                                       HorizontalOptions="Center" Margin="0,14,0,0">
                                    <Button Text="I'm done for today" Clicked="DeclineResetClicked"
                                            BackgroundColor="Transparent" TextColor="{DynamicResource Ink}"
                                            BorderColor="{DynamicResource Line}" BorderWidth="1"
                                            CornerRadius="14" Padding="18,10" FontFamily="OpenSansSemibold" />
                                    <Button Text="Reset clock in and out" Clicked="ConfirmResetClicked"
                                            BackgroundColor="{StaticResource Brand}" TextColor="#FFFFFF"
                                            CornerRadius="14" Padding="18,10" FontFamily="OpenSansSemibold" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="SuccessPanel" IsVisible="False" Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding SuccessTitle}" FontFamily="OpenSansSemibold" FontSize="16" CharacterSpacing="2"
                                       TextColor="{StaticResource Success}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding SuccessTime}" FontFamily="OpenSansSemibold" FontSize="58"
                                       HorizontalTextAlignment="Center" Margin="0,-6,0,-4" />
                                <Label Text="{Binding SuccessDetail}" FontSize="16" TextColor="{DynamicResource Muted}"
                                       HorizontalTextAlignment="Center" />
                                <Grid WidthRequest="220" HeightRequest="4" Margin="0,12,0,0" HorizontalOptions="Center">
                                    <BoxView Color="{DynamicResource Line}" CornerRadius="2" />
                                    <BoxView x:Name="CountdownFill" Color="{StaticResource Success}" CornerRadius="2" AnchorX="0" />
                                </Grid>
                            </VerticalStackLayout>

                            <HorizontalStackLayout x:Name="Stepper" Grid.Row="1" HorizontalOptions="Center" Spacing="0" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Live activity -->
                <Border Grid.Column="1" BackgroundColor="{DynamicResource Stage}" Stroke="{DynamicResource Line}"
                        StrokeThickness="1" Padding="22,22,22,8" StrokeShape="RoundRectangle 28">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="Live activity" FontFamily="OpenSansSemibold" FontSize="24" />
                                <Label Text="{Binding SessionCaption}" FontSize="14" TextColor="{DynamicResource Muted}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Padding="12,6" VerticalOptions="Center" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14" BackgroundColor="{DynamicResource Glass}"
                                    Stroke="{DynamicResource Line}">
                                <HorizontalStackLayout Spacing="8">
                                    <Grid WidthRequest="12" HeightRequest="12" VerticalOptions="Center">
                                        <Border x:Name="FeedRipple" WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource Success}"
                                                HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Border WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource Success}"
                                                HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Text="Live" FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Border x:Name="OnShiftTile" Padding="14,12" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource Brand}" Offset="0" />
                                        <GradientStop Color="{StaticResource Highlight}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Shadow>
                                    <Shadow Brush="#AB1100" Opacity="0.35" Radius="18" Offset="0,6" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="0">
                                    <Label x:Name="OnShiftValue" Text="0" FontFamily="OpenSansSemibold" FontSize="30" TextColor="#FFFFFF" />
                                    <Label Text="On shift" FontSize="13" TextColor="#E6FFFFFF" />
                                </VerticalStackLayout>
                            </Border>
                            <Border x:Name="InTile" Grid.Column="1" Padding="14,12" StrokeThickness="1" StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}">
                                <VerticalStackLayout Spacing="0">
                                    <Label x:Name="InValue" Text="0" FontFamily="OpenSansSemibold" FontSize="30" />
                                    <Label Text="In today" FontSize="13" TextColor="{DynamicResource Muted}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border x:Name="OutTile" Grid.Column="2" Padding="14,12" StrokeThickness="1" StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}">
                                <VerticalStackLayout Spacing="0">
                                    <Label x:Name="OutValue" Text="0" FontFamily="OpenSansSemibold" FontSize="30" />
                                    <Label Text="Out today" FontSize="13" TextColor="{DynamicResource Muted}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <CollectionView Grid.Row="2" ItemsSource="{Binding Punches}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Spacing="6" Padding="8,36,8,0" HorizontalOptions="Center">
                                    <Grid WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" Margin="0,0,0,10">
                                        <Border x:Name="EmptyRingOuter" WidthRequest="56" HeightRequest="56" StrokeThickness="1.5"
                                                Stroke="{StaticResource Highlight}" StrokeShape="RoundRectangle 28"
                                                HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Border x:Name="EmptyRingInner" WidthRequest="56" HeightRequest="56" StrokeThickness="1.5"
                                                Stroke="{StaticResource Brand}" StrokeShape="RoundRectangle 28"
                                                HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 28"
                                                HorizontalOptions="Center" VerticalOptions="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{StaticResource Brand}" Offset="0" />
                                                    <GradientStop Color="{StaticResource Highlight}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Label Text="ID" FontFamily="OpenSansSemibold" FontSize="16" TextColor="#FFFFFF"
                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <Label Text="Waiting for the first punch" FontFamily="OpenSansSemibold" FontSize="20"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Scans on this kiosk appear here in real time." FontSize="14"
                                           TextColor="{DynamicResource Muted}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PunchRow">
                                    <Grid ColumnDefinitions="16,*" ColumnSpacing="10"
                                          Loaded="OnPunchRowAttached" BindingContextChanged="OnPunchRowAttached">
                                        <BoxView WidthRequest="2" Color="{DynamicResource Line}" HorizontalOptions="Center"
                                                 Margin="0,-10" />
                                        <Border WidthRequest="12" HeightRequest="12" StrokeThickness="2"
                                                StrokeShape="RoundRectangle 6" BackgroundColor="{Binding Accent}"
                                                Stroke="{DynamicResource Canvas}" VerticalOptions="Center" HorizontalOptions="Center" />
                                        <Border Grid.Column="1" Padding="12" StrokeThickness="1" StrokeShape="RoundRectangle 18"
                                                BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 14" BackgroundColor="{Binding Accent}"
                                                        VerticalOptions="Center">
                                                    <Grid>
                                                        <Label Text="{Binding Initials}" FontFamily="OpenSansSemibold" FontSize="15"
                                                               TextColor="#FFFFFF"
                                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                               IsVisible="{Binding ShowInitials}" />
                                                        <Image Source="{Binding PhotoPath}" Aspect="AspectFill" WidthRequest="46"
                                                               HeightRequest="46" IsVisible="{Binding HasPhoto}" />
                                                    </Grid>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Detail}" FontSize="13" TextColor="{DynamicResource Faint}"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                                                    <Label Text="{Binding Time}" FontFamily="OpenSansSemibold" FontSize="15"
                                                           HorizontalTextAlignment="End" />
                                                    <Border Padding="8,3" StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                                            BackgroundColor="{Binding Accent}" HorizontalOptions="End">
                                                        <Label Text="{Binding Action}" FontFamily="OpenSansSemibold" FontSize="12"
                                                               TextColor="#FFFFFF" />
                                                    </Border>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Footer ============ -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <Label Text="{Binding ConnectionCaption}" FontSize="13" TextColor="{DynamicResource Faint}"
                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
                <Label Grid.Column="1" Text="Scan only  ·  No manual clock in or clock out  ·  Times cannot be edited"
                       FontSize="13" TextColor="{DynamicResource Faint}" VerticalOptions="Center" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
