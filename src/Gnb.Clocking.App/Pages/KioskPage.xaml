<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gnb.Clocking.App.ViewModels"
             xmlns:camera="clr-namespace:Gnb.Clocking.App.Camera"
             xmlns:controls="clr-namespace:Gnb.Clocking.App.Controls"
             x:Class="Gnb.Clocking.App.Pages.KioskPage"
             x:DataType="vm:KioskViewModel"
             x:Name="PageRoot"
             BackgroundColor="{DynamicResource Canvas}">

    <Grid>
        <!-- Ambient backdrop: static dot grid, GPU-moved glows, scan flashes. -->
        <controls:AuroraBackdrop x:Name="Aurora" />

        <Grid x:Name="PageGrid" RowDefinitions="Auto,*,Auto" Padding="28,20,28,14" RowSpacing="18">

            <!-- ============ Header ============ -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24">
                <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                    <Border x:Name="LogoTile" WidthRequest="52" HeightRequest="52" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource Brand}" Offset="0" />
                                <GradientStop Color="{StaticResource Highlight}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#AB1100" Opacity="0.45" Radius="22" Offset="0,6" />
                        </Border.Shadow>
                        <Label Text="GN" FontFamily="OpenSansSemibold" FontSize="19" TextColor="#FFFFFF"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                        <Label Text="GroupNB" FontFamily="OpenSansSemibold" FontSize="24" />
                        <Label Text="RFID time clock" FontSize="14" TextColor="{DynamicResource Muted}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Padding="16,10"
                        BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 22">
                    <HorizontalStackLayout Spacing="12">
                        <Grid WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                            <Border x:Name="LiveRipple" WidthRequest="10" HeightRequest="10" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5" BackgroundColor="{StaticResource Highlight}"
                                    HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5" BackgroundColor="{StaticResource Highlight}"
                                    HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="Reader live" FontFamily="OpenSansSemibold" FontSize="14" VerticalOptions="Center" />
                        <BoxView WidthRequest="1" HeightRequest="16" Color="{DynamicResource Line}" VerticalOptions="Center" />
                        <Border x:Name="ServerDot" WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                StrokeShape="RoundRectangle 4" BackgroundColor="#718096" VerticalOptions="Center" />
                        <Label Text="{Binding ServerCaption}" FontSize="14" TextColor="{DynamicResource Muted}" VerticalOptions="Center" />
                        <!-- Only visible when punches are waiting on this device. -->
                        <BoxView WidthRequest="1" HeightRequest="16" Color="{DynamicResource Line}" VerticalOptions="Center"
                                 IsVisible="{Binding HasOfflineWork}" />
                        <Border IsVisible="{Binding HasOfflineWork}" Padding="10,4" StrokeThickness="1"
                                StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource WarningSoft}"
                                Stroke="{DynamicResource WarningBorder}" VerticalOptions="Center">
                            <Label Text="{Binding OfflineCaption}" FontFamily="OpenSansSemibold" FontSize="13"
                                   TextColor="{DynamicResource WarningText}" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>

                <HorizontalStackLayout Grid.Column="2" Spacing="24" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="0">
                            <Label x:Name="HoursLabel" Text="{Binding ClockHours}" FontFamily="OpenSansSemibold" FontSize="44" />
                            <Label x:Name="Colon" Text=":" FontFamily="OpenSansSemibold" FontSize="40" Margin="3,-3,3,0" />
                            <Label x:Name="MinutesLabel" Text="{Binding ClockMinutes}" FontFamily="OpenSansSemibold" FontSize="44" />
                            <Label Text="{Binding ClockMeridiem}" FontSize="16" TextColor="{DynamicResource Muted}"
                                   VerticalOptions="End" Margin="8,0,0,10" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding DateLine}" FontSize="14" TextColor="{DynamicResource Muted}"
                               HorizontalTextAlignment="End" Margin="0,-4,0,0" />
                    </VerticalStackLayout>

                    <!-- Segmented appearance switch with a sliding indicator. -->
                    <Border Padding="4" VerticalOptions="Center" StrokeThickness="1" StrokeShape="RoundRectangle 20"
                            BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}">
                        <Grid ColumnDefinitions="72,72,72" HeightRequest="34">
                            <Border x:Name="ThemeIndicator" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource Brand}" Offset="0" />
                                        <GradientStop Color="{StaticResource Highlight}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Label x:Name="ThemeLight" Grid.Column="0" Text="Light" FontFamily="OpenSansSemibold" FontSize="13"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeTapped" CommandParameter="Light" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="ThemeDark" Grid.Column="1" Text="Dark" FontFamily="OpenSansSemibold" FontSize="13"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeTapped" CommandParameter="Dark" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label x:Name="ThemeSystem" Grid.Column="2" Text="System" FontFamily="OpenSansSemibold" FontSize="13"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeTapped" CommandParameter="System" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- ============ Body ============ -->
            <Grid x:Name="BodyGrid" Grid.Row="1" ColumnDefinitions="1.75*,1*" ColumnSpacing="20">

                <!-- Scanner stage -->
                <Border Grid.Column="0" BackgroundColor="{DynamicResource Stage}"
                        Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 28">
                    <Grid x:Name="StageGrid" RowDefinitions="Auto,Auto,*,Auto" Padding="24,16,24,16" RowSpacing="12">

                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Border x:Name="PhaseChip" Padding="12,6" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                    <HorizontalStackLayout Spacing="8">
                                        <Border x:Name="PhaseDot" WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4" VerticalOptions="Center" />
                                        <Label x:Name="PhaseLabel" Text="Ready" FontFamily="OpenSansSemibold" FontSize="13"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Label Text="Badge + photo verification" FontSize="13" TextColor="{DynamicResource Faint}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" Padding="12,6" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}">
                                <HorizontalStackLayout Spacing="8">
                                    <Border x:Name="CameraDot" WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 4" BackgroundColor="#718096" VerticalOptions="Center" />
                                    <Label x:Name="CameraChipLabel" Text="Starting camera" FontSize="13"
                                           TextColor="{DynamicResource Muted}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Hidden sink for the USB reader's keystrokes. -->
                            <Entry x:Name="RfidEntry"
                                   Grid.ColumnSpan="2"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Opacity="0"
                                   HeightRequest="1"
                                   WidthRequest="1"
                                   TextColor="Transparent"
                                   BackgroundColor="Transparent"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"
                                   ClearButtonVisibility="Never"
                                   Keyboard="Plain"
                                   ReturnType="Done"
                                   TextChanged="OnRfidTextChanged"
                                   Completed="OnRfidCompleted" />
                        </Grid>

                        <!-- Stepper sits above the camera, centered, with room so the rings do not touch it. -->
                        <Grid x:Name="StepperRow" Grid.Row="1" Padding="0,4,0,16"
                              HorizontalOptions="Fill" VerticalOptions="Center">
                            <HorizontalStackLayout x:Name="Stepper"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Spacing="0" />
                        </Grid>

                        <!-- Camera, halo and floating HUD. Sized in code from the available space. -->
                        <Grid x:Name="ScannerArea" Grid.Row="2" SizeChanged="OnScannerSizeChanged">
                            <controls:ScannerHalo x:Name="Halo" HorizontalOptions="Center" VerticalOptions="Center" />

                            <Border x:Name="CameraFrame" WidthRequest="360" HeightRequest="360" Padding="0"
                                    StrokeThickness="3" BackgroundColor="#000000"
                                    HorizontalOptions="Center" VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 150">
                                <Grid>
                                    <camera:ClockCameraView x:Name="ClockCamera" />
                                    <Label x:Name="CameraFallback" Text="Starting camera" TextColor="#FFFFFF"
                                           FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                           Margin="24,0" />
                                    <Image x:Name="SuccessPhotoImage" Source="{Binding SuccessPhoto}" Aspect="AspectFill"
                                           IsVisible="False" />
                                    <BoxView x:Name="ScanLine" HeightRequest="90" VerticalOptions="Center"
                                             Opacity="0" InputTransparent="True">
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00C70000" Offset="0" />
                                                <GradientStop Color="#40C70000" Offset="0.8" />
                                                <GradientStop Color="#FFC70000" Offset="0.97" />
                                                <GradientStop Color="#00C70000" Offset="1" />
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>
                                    <Border x:Name="Shutter" BackgroundColor="#FFFFFF" Opacity="0" InputTransparent="True"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 150" />
                                </Grid>
                            </Border>

                            <Border x:Name="SuccessBadge" IsVisible="False" WidthRequest="64" HeightRequest="64"
                                    StrokeThickness="4" Stroke="{DynamicResource Canvas}" StrokeShape="RoundRectangle 32"
                                    BackgroundColor="{DynamicResource SuccessSolid}"
                                    HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                                <Border.Shadow>
                                    <Shadow Brush="#15803D" Opacity="0.5" Radius="20" />
                                </Border.Shadow>
                                <Label Text="✓" FontFamily="OpenSansSemibold" FontSize="30" TextColor="{DynamicResource SuccessOnSolid}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>

                            <!-- Identity HUD while the photo is taken. -->
                            <Border x:Name="IdentityChip" IsVisible="False" VerticalOptions="End" HorizontalOptions="Center"
                                    Padding="12,12,16,12" Margin="0,0,0,2" StrokeThickness="1" StrokeShape="RoundRectangle 24"
                                    BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}">
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Opacity="0.25" Radius="30" Offset="0,10" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="14">
                                    <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                            VerticalOptions="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{StaticResource Brand}" Offset="0" />
                                                <GradientStop Color="{StaticResource Highlight}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Label Text="{Binding Initials}" FontFamily="OpenSansSemibold" FontSize="19" TextColor="#FFFFFF"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1" MaximumWidthRequest="380">
                                        <Label Text="{Binding CandidateName}" FontFamily="OpenSansSemibold" FontSize="20"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding AssignmentLine}" FontSize="13" TextColor="{DynamicResource Muted}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding StatusDetail}" FontSize="13" TextColor="{DynamicResource Faint}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Border x:Name="ActionPill" Grid.Column="2" Padding="14,8" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                                        <Label x:Name="ActionPillLabel" Text="{Binding ActionTitle}" FontFamily="OpenSansSemibold"
                                               FontSize="14" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="UnknownBanner" IsVisible="False" VerticalOptions="Start" HorizontalOptions="Center"
                                    Padding="14,12,20,12" Margin="0,4,0,0" StrokeThickness="1" StrokeShape="RoundRectangle 18"
                                    BackgroundColor="{DynamicResource ErrorSoft}" Stroke="{DynamicResource ErrorBorder}">
                                <HorizontalStackLayout Spacing="12">
                                    <Border WidthRequest="26" HeightRequest="26" StrokeThickness="0" StrokeShape="RoundRectangle 13"
                                            BackgroundColor="{DynamicResource ErrorSolid}" VerticalOptions="Center">
                                        <Label Text="×" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{DynamicResource ErrorOnSolid}"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Margin="0,-2,0,0" />
                                    </Border>
                                    <Label Text="{Binding UnknownMessage}" TextColor="{DynamicResource Ink}" FontSize="16"
                                           FontFamily="OpenSansSemibold" VerticalOptions="Center" MaximumWidthRequest="560"
                                           LineBreakMode="WordWrap" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Prompt / result copy. Height tightens at 1366×768 so the camera still fits. -->
                        <Grid x:Name="PromptBand" Grid.Row="3" HeightRequest="168">
                            <VerticalStackLayout x:Name="PromptStack" Spacing="2"
                                                 HorizontalOptions="Center" VerticalOptions="Center">
                                <Label x:Name="PromptTitle" Text="{Binding Prompt}" FontFamily="OpenSansSemibold" FontSize="28"
                                       HorizontalTextAlignment="Center" />
                                <Label x:Name="PromptDetail" Text="{Binding PromptDetail}" FontSize="18" TextColor="{DynamicResource Ink}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="SuccessPanel" IsVisible="False" Spacing="0"
                                                 HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding SuccessTitle}" FontFamily="OpenSansSemibold" FontSize="16" CharacterSpacing="2"
                                       TextColor="{DynamicResource SuccessText}" HorizontalTextAlignment="Center" />
                                <Label x:Name="SuccessTimeLabel" Text="{Binding SuccessTime}" FontFamily="OpenSansSemibold" FontSize="58"
                                       HorizontalTextAlignment="Center" Margin="0,-6,0,-4" />
                                <Label Text="{Binding SuccessDetail}" FontSize="16" TextColor="{DynamicResource Muted}"
                                       HorizontalTextAlignment="Center" />
                                <Border IsVisible="{Binding SuccessSavedHere}" Padding="12,6" Margin="0,8,0,0"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{DynamicResource WarningSoft}" Stroke="{DynamicResource WarningBorder}"
                                        HorizontalOptions="Center">
                                    <Label Text="Saved on this clock — it will sync when the office is back"
                                           FontFamily="OpenSansSemibold" FontSize="14" TextColor="{DynamicResource WarningText}" />
                                </Border>
                                <Grid WidthRequest="220" HeightRequest="4" Margin="0,12,0,0" HorizontalOptions="Center">
                                    <BoxView Color="{DynamicResource Line}" CornerRadius="2" />
                                    <BoxView x:Name="CountdownFill" Color="{DynamicResource SuccessSolid}" CornerRadius="2" AnchorX="0" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Live activity -->
                <Border x:Name="ActivityCard" Grid.Column="1" BackgroundColor="{DynamicResource Stage}" Stroke="{DynamicResource Line}"
                        StrokeThickness="1" Padding="22,22,22,8" StrokeShape="RoundRectangle 28">
                    <Grid x:Name="ActivityGrid" RowDefinitions="Auto,Auto,*" RowSpacing="18">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="Live activity" FontFamily="OpenSansSemibold" FontSize="{DynamicResource ActivityTitleSize}" />
                                <Label Text="{Binding SessionCaption}" FontSize="{DynamicResource ActivityCaptionSize}"
                                       TextColor="{DynamicResource Muted}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Padding="12,6" VerticalOptions="Center" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14" BackgroundColor="{DynamicResource Glass}"
                                    Stroke="{DynamicResource Line}">
                                <HorizontalStackLayout Spacing="8">
                                    <Grid WidthRequest="12" HeightRequest="12" VerticalOptions="Center">
                                        <Border x:Name="FeedRipple" WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4" BackgroundColor="{DynamicResource SuccessSolid}"
                                                HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Border WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4" BackgroundColor="{DynamicResource SuccessSolid}"
                                                HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Text="Live" FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Border Padding="{DynamicResource ActivityTilePadding}" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource Brand}" Offset="0" />
                                        <GradientStop Color="{StaticResource Highlight}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Shadow>
                                    <Shadow Brush="#AB1100" Opacity="0.35" Radius="18" Offset="0,6" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="0">
                                    <Label x:Name="OnShiftValue" Text="0" FontFamily="OpenSansSemibold" FontSize="{DynamicResource ActivityValueSize}" TextColor="#FFFFFF" />
                                    <Label x:Name="OnShiftLabel" Text="On shift" FontSize="{DynamicResource ActivityTileLabelSize}"
                                           TextColor="#E6FFFFFF" LineBreakMode="NoWrap" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Padding="{DynamicResource ActivityTilePadding}" StrokeThickness="1" StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}">
                                <VerticalStackLayout Spacing="0">
                                    <Label x:Name="InValue" Text="0" FontFamily="OpenSansSemibold" FontSize="{DynamicResource ActivityValueSize}" />
                                    <Label x:Name="InLabel" Text="In today" FontSize="{DynamicResource ActivityTileLabelSize}"
                                           TextColor="{DynamicResource Muted}" LineBreakMode="NoWrap" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Padding="{DynamicResource ActivityTilePadding}" StrokeThickness="1" StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}">
                                <VerticalStackLayout Spacing="0">
                                    <Label x:Name="OutValue" Text="0" FontFamily="OpenSansSemibold" FontSize="{DynamicResource ActivityValueSize}" />
                                    <Label x:Name="OutLabel" Text="Out today" FontSize="{DynamicResource ActivityTileLabelSize}"
                                           TextColor="{DynamicResource Muted}" LineBreakMode="NoWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <CollectionView Grid.Row="2" ItemsSource="{Binding Punches}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Spacing="6" Padding="8,36,8,0" HorizontalOptions="Center">
                                    <Grid WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" Margin="0,0,0,10">
                                        <Border x:Name="EmptyRingOuter" WidthRequest="56" HeightRequest="56" StrokeThickness="1.5"
                                                Stroke="{StaticResource Highlight}" StrokeShape="RoundRectangle 28"
                                                HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Border x:Name="EmptyRingInner" WidthRequest="56" HeightRequest="56" StrokeThickness="1.5"
                                                Stroke="{StaticResource Brand}" StrokeShape="RoundRectangle 28"
                                                HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 28"
                                                HorizontalOptions="Center" VerticalOptions="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{StaticResource Brand}" Offset="0" />
                                                    <GradientStop Color="{StaticResource Highlight}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Label Text="ID" FontFamily="OpenSansSemibold" FontSize="16" TextColor="#FFFFFF"
                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <Label Text="Waiting for the first punch" FontFamily="OpenSansSemibold" FontSize="20"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Scans on this kiosk appear here in real time." FontSize="14"
                                           TextColor="{DynamicResource Muted}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PunchRow">
                                    <Grid ColumnDefinitions="16,*" ColumnSpacing="10"
                                          Loaded="OnPunchRowAttached" BindingContextChanged="OnPunchRowAttached">
                                        <BoxView WidthRequest="2" Color="{DynamicResource Line}" HorizontalOptions="Center"
                                                 Margin="0,-10" />
                                        <Border WidthRequest="12" HeightRequest="12" StrokeThickness="2"
                                                StrokeShape="RoundRectangle 6" BackgroundColor="{Binding Accent}"
                                                Stroke="{DynamicResource Canvas}" VerticalOptions="Center" HorizontalOptions="Center" />
                                        <Border Grid.Column="1" Padding="{DynamicResource RowPadding}" StrokeThickness="1" StrokeShape="RoundRectangle 18"
                                                BackgroundColor="{DynamicResource Glass}" Stroke="{DynamicResource Line}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border WidthRequest="{DynamicResource RowAvatarSize}"
                                                        HeightRequest="{DynamicResource RowAvatarSize}" StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 14" BackgroundColor="{Binding Accent}"
                                                        VerticalOptions="Center">
                                                    <Grid>
                                                        <Label Text="{Binding Initials}" FontFamily="OpenSansSemibold" FontSize="15"
                                                               TextColor="#FFFFFF"
                                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                               IsVisible="{Binding ShowInitials}" />
                                                        <Image Source="{Binding PhotoPath}" Aspect="AspectFill"
                                                               WidthRequest="{DynamicResource RowAvatarSize}"
                                                               HeightRequest="{DynamicResource RowAvatarSize}"
                                                               IsVisible="{Binding HasPhoto}" />
                                                    </Grid>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="{DynamicResource RowNameSize}"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Detail}" FontSize="{DynamicResource RowDetailSize}" TextColor="{DynamicResource Faint}"
                                                           LineBreakMode="TailTruncation" />
                                                    <!-- Captured here during an outage: the shift is real, the server just has not seen it. -->
                                                    <HorizontalStackLayout Spacing="6" IsVisible="{Binding ShowPendingNote}">
                                                        <Border WidthRequest="6" HeightRequest="6" StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 3" BackgroundColor="{DynamicResource WarningSolid}"
                                                                VerticalOptions="Center" />
                                                        <Label Text="Saved here, not synced" FontFamily="OpenSansSemibold" FontSize="12"
                                                               TextColor="{DynamicResource WarningText}" />
                                                    </HorizontalStackLayout>
                                                    <!-- Refused by the server on sync: an error, not a pending note. -->
                                                    <HorizontalStackLayout Spacing="6" IsVisible="{Binding ShowAttentionNote}">
                                                        <Border WidthRequest="6" HeightRequest="6" StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 3" BackgroundColor="{DynamicResource ErrorSolid}"
                                                                VerticalOptions="Center" />
                                                        <Label Text="Needs attention" FontFamily="OpenSansSemibold" FontSize="12"
                                                               TextColor="{DynamicResource ErrorText}" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                                                    <Label Text="{Binding Time}" FontFamily="OpenSansSemibold" FontSize="{DynamicResource RowTimeSize}"
                                                           HorizontalTextAlignment="End" />
                                                    <Border Padding="8,3" StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                                            BackgroundColor="{Binding Accent}" HorizontalOptions="End">
                                                        <Label Text="{Binding Action}" FontFamily="OpenSansSemibold" FontSize="{DynamicResource RowBadgeSize}"
                                                               TextColor="#FFFFFF" />
                                                    </Border>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Footer ============ -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <Label Text="{Binding ConnectionCaption}" FontSize="13" TextColor="{DynamicResource Faint}"
                       VerticalOptions="Center" LineBreakMode="TailTruncation" />
                <Label Grid.Column="1" Text="Scan only  ·  No manual clock in or clock out  ·  Times cannot be edited"
                       FontSize="13" TextColor="{DynamicResource Faint}" VerticalOptions="Center" />
            </Grid>
        </Grid>

        <!-- ============ Cooldown: this tap is too soon. Neutral: nothing is wrong, just wait. ============ -->
        <Grid x:Name="HoldOverlay" IsVisible="False">
            <BoxView x:Name="HoldScrim" Color="#0B0F16" Opacity="0" />

            <Border x:Name="HoldCard" HorizontalOptions="Center" VerticalOptions="Center"
                    MaximumWidthRequest="720" Padding="0" StrokeThickness="1.5"
                    BackgroundColor="{DynamicResource Canvas}" Stroke="{DynamicResource NeutralBorder}"
                    StrokeShape="RoundRectangle 34">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.55" Radius="60" Offset="0,18" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto">
                    <BoxView HeightRequest="5" Color="{DynamicResource NeutralSolid}" />

                    <VerticalStackLayout Grid.Row="1" Spacing="18" Padding="36,26,36,26">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <!-- Clock glyph drawn with shapes: OpenSans has no clock character. -->
                            <Border WidthRequest="58" HeightRequest="58" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18" BackgroundColor="{DynamicResource NeutralSoft}"
                                    Stroke="{DynamicResource NeutralBorder}" VerticalOptions="Center">
                                <Grid WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Ellipse Stroke="{DynamicResource NeutralSolid}" StrokeThickness="2.5" />
                                    <BoxView WidthRequest="2.5" HeightRequest="9" Color="{DynamicResource NeutralSolid}"
                                             HorizontalOptions="Center" VerticalOptions="Start" Margin="0,6,0,0" CornerRadius="1" />
                                    <BoxView WidthRequest="7" HeightRequest="2.5" Color="{DynamicResource NeutralSolid}"
                                             HorizontalOptions="Start" VerticalOptions="Center" Margin="13.5,1,0,0" CornerRadius="1" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding CandidateName}" FontFamily="OpenSansSemibold" FontSize="24"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding AssignmentLine}" FontSize="14" TextColor="{DynamicResource Muted}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource Line}" />

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding HoldTitle}" FontFamily="OpenSansSemibold" FontSize="34"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding HoldSince}" FontSize="18" TextColor="{DynamicResource Muted}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- The one line that matters: when they may tap again. -->
                        <Border Padding="24,16" StrokeThickness="1" StrokeShape="RoundRectangle 20"
                                BackgroundColor="{DynamicResource NeutralSoft}" Stroke="{DynamicResource NeutralBorder}"
                                HorizontalOptions="Center">
                            <Label Text="{Binding HoldReady}" FontFamily="OpenSansSemibold" FontSize="24"
                                   TextColor="{DynamicResource Ink}" HorizontalTextAlignment="Center" />
                        </Border>

                        <Label Text="Nothing was saved for this tap. Your earlier punch still stands."
                               FontSize="15" TextColor="{DynamicResource Muted}" HorizontalTextAlignment="Center" />

                        <Border Padding="16,13" StrokeThickness="1"
                                StrokeShape="RoundRectangle 20" BackgroundColor="{DynamicResource Glass}"
                                Stroke="{DynamicResource LineStrong}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Grid WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                    <Border x:Name="HoldNextPersonPulse" WidthRequest="44" HeightRequest="44"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{DynamicResource NeutralBorder}"
                                            HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{StaticResource Brand}" Offset="0" />
                                                <GradientStop Color="{StaticResource Highlight}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Label Text="ID" FontFamily="OpenSansSemibold" FontSize="15" TextColor="#FFFFFF"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="Next person: tap your badge now" FontFamily="OpenSansSemibold" FontSize="19" />
                                    <Label Text="The reader is live. This message closes on its own."
                                           FontSize="15" TextColor="{DynamicResource Muted}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Grid HeightRequest="6" WidthRequest="280" HorizontalOptions="Center">
                            <BoxView Color="{DynamicResource Line}" CornerRadius="3" />
                            <BoxView x:Name="HoldAutoFill" Color="{DynamicResource NeutralSolid}" CornerRadius="3" AnchorX="0" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ RFID dialog: Warning. The card is not linked to a Working candidate; staff must act. ============ -->
        <Grid x:Name="RfidOverlay" IsVisible="False">
            <BoxView x:Name="RfidScrim" Color="#0B0F16" Opacity="0">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRfidScrimTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="RfidCard" HorizontalOptions="Center" VerticalOptions="Center"
                    MaximumWidthRequest="720" Padding="0" StrokeThickness="1.5"
                    BackgroundColor="{DynamicResource Canvas}" Stroke="{DynamicResource WarningBorder}"
                    StrokeShape="RoundRectangle 34">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.55" Radius="60" Offset="0,18" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto">
                    <BoxView HeightRequest="5" Color="{DynamicResource WarningSolid}" />

                    <VerticalStackLayout Grid.Row="1" Spacing="18" Padding="36,26,36,26">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border WidthRequest="58" HeightRequest="58" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18" BackgroundColor="{DynamicResource WarningSoft}"
                                    Stroke="{DynamicResource WarningBorder}" VerticalOptions="Center">
                                <Label x:Name="RfidIconLabel" Text="!" FontFamily="OpenSansSemibold" FontSize="28"
                                       TextColor="{DynamicResource WarningText}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding RfidTitle}" FontFamily="OpenSansSemibold" FontSize="26"
                                       LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="10" IsVisible="{Binding HasRfidHolder}">
                                    <Label Text="{Binding RfidHolderName}" FontSize="15" TextColor="{DynamicResource Muted}"
                                           VerticalOptions="Center" LineBreakMode="TailTruncation" MaximumWidthRequest="420" />
                                    <!-- Why the card was refused. Neutral: the kiosk does not grade statuses. -->
                                    <Border IsVisible="{Binding HasRfidHolderStatus}" Padding="10,3" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 11" BackgroundColor="{DynamicResource NeutralSoft}"
                                            Stroke="{DynamicResource NeutralBorder}" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="6">
                                            <Border WidthRequest="6" HeightRequest="6" StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 3" BackgroundColor="{DynamicResource NeutralSolid}"
                                                    VerticalOptions="Center" />
                                            <Label Text="{Binding RfidHolderStatus}" FontFamily="OpenSansSemibold" FontSize="13"
                                                   TextColor="{DynamicResource Ink}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource Line}" />

                        <!-- The one thing staff need: the number to type into the ERP. Data, so Ink, not a status colour. -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="RFID NUMBER" FontFamily="OpenSansSemibold" FontSize="13" CharacterSpacing="3"
                                   TextColor="{DynamicResource Muted}" HorizontalTextAlignment="Center" />
                            <Border x:Name="RfidNumberChip" Padding="28,12" StrokeThickness="1.5" StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{DynamicResource WarningSoft}" Stroke="{DynamicResource WarningBorder}"
                                    HorizontalOptions="Center">
                                <Label Text="{Binding RfidNumber}" FontFamily="OpenSansSemibold" FontSize="40"
                                       CharacterSpacing="4" TextColor="{DynamicResource Ink}" HorizontalTextAlignment="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <Label Text="{Binding RfidDetail}" FontSize="16" TextColor="{DynamicResource Muted}"
                               HorizontalTextAlignment="Center" MaximumWidthRequest="600" />

                        <Label Text="Nothing was saved for this tap."
                               FontSize="15" TextColor="{DynamicResource Muted}" HorizontalTextAlignment="Center" />

                        <Border Padding="16,13" StrokeThickness="1"
                                StrokeShape="RoundRectangle 20" BackgroundColor="{DynamicResource Glass}"
                                Stroke="{DynamicResource LineStrong}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Grid WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                    <Border x:Name="RfidNextPersonPulse" WidthRequest="44" HeightRequest="44"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{DynamicResource NeutralBorder}"
                                            HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{StaticResource Brand}" Offset="0" />
                                                <GradientStop Color="{StaticResource Highlight}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Label Text="ID" FontFamily="OpenSansSemibold" FontSize="15" TextColor="#FFFFFF"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="Next person: tap your badge now" FontFamily="OpenSansSemibold" FontSize="19" />
                                    <Label Text="The reader is live. This message closes in 10 seconds."
                                           FontSize="15" TextColor="{DynamicResource Muted}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Grid HeightRequest="6" WidthRequest="280" HorizontalOptions="Center">
                            <BoxView Color="{DynamicResource Line}" CornerRadius="3" />
                            <BoxView x:Name="RfidAutoFill" Color="{DynamicResource WarningSolid}" CornerRadius="3" AnchorX="0" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
